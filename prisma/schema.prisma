generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ScrapeStatus {
  running
  completed
  failed
  cancelled
  interrupted
}

/// A logged-in Instagram session (the Netflix-style "profile"). Owns its own
/// cookie/user-agent and all scraped data via `profileId` on every collection.
model Profile {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  name                String  @unique
  avatarUrl           String? // IG profile pic (auto-filled on first scrape) or custom
  avatarColor         String? // deterministic fallback tile color
  instagramCookie     String? // per-profile session cookie (was global setting)
  userAgent           String? // per-profile user-agent (was global setting)
  igUserPk            String? // the logged-in account's own IG pk (for avatar)
  igUsername          String?
  lostStateBackfilled Boolean @default(false) // was global setting `lost_state_backfilled`
  createdAt           String
  updatedAt           String

  @@map("profiles")
}

model Account {
  id                      String  @id @default(auto()) @map("_id") @db.ObjectId
  pk                      String // Instagram user pk (was the document _id pre-multiprofile)
  profileId               String
  username                String
  fullName                String  @default("")
  isVerified              Boolean @default(false)
  isPrivate               Boolean @default(false)
  profilePicUrl           String?
  profilePicHash          String?
  cloudinaryProfilePicUrl String?
  savedPostCount          Int     @default(0)
  notes                   String?
  firstSeenAt             String
  lastSeenAt              String
  lastScrapeOn            String?
  accountStatus           String?
  statusChangedAt         String?
  existsAlso              String?
  discoveredInRunId       Int?
  lostAt                  String?
  recoveredAt             String?

  @@unique([profileId, pk])
  @@unique([profileId, username])
  @@index([profileId])
  @@index([profileId, savedPostCount])
  @@index([profileId, lastSeenAt])
  @@index([profileId, firstSeenAt])
  @@index([profileId, discoveredInRunId])
  @@index([profileId, lostAt])
  @@map("accounts")
}

model AccountNote {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  profileId String
  accountPk String
  content   String
  createdAt String

  @@index([profileId, accountPk])
  @@map("accountNotes")
}

model AccountStatusHistory {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  profileId String
  accountPk String
  status    String
  changedAt String

  @@index([profileId, accountPk])
  @@map("accountStatusHistory")
}

model AccountUsernameHistory {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String
  accountPk   String
  oldUsername String
  newUsername String
  scrapeRunId Int?
  changedAt   String

  @@index([profileId, accountPk])
  @@index([profileId, scrapeRunId])
  @@map("accountUsernameHistory")
}

model Post {
  id                     String  @id @default(auto()) @map("_id") @db.ObjectId
  mediaId                String // Instagram media.id (was the `id` field pre-multiprofile)
  pk                     String // Instagram media pk (was the document _id pre-multiprofile)
  profileId              String
  code                   String
  accountPk              String
  mediaType              Int
  takenAt                Int
  captionText            String?
  likeCount              Int     @default(0)
  commentCount           Int     @default(0)
  thumbnailUrl           String?
  cloudinaryThumbnailUrl String?
  thumbnailWidth         Int?
  thumbnailHeight        Int?
  carouselMediaCount     Int?
  scrapeRunId            Int?
  createdAt              String

  @@unique([profileId, pk])
  @@index([profileId])
  @@index([profileId, accountPk])
  @@index([profileId, scrapeRunId])
  @@index([profileId, mediaType])
  @@index([profileId, takenAt])
  @@map("posts")
}

model CarouselMedia {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  profileId     String
  postPk        String
  position      Int
  mediaType     Int
  mediaUrl      String
  width         Int?
  height        Int?
  videoUrl      String?
  videoDuration Float?
  cloudinaryUrl String?

  @@index([profileId, postPk])
  @@map("carouselMedia")
}

model ScrapeRun {
  id                          Int          @id @map("_id")
  profileId                   String
  status                      ScrapeStatus @default(running)
  startedAt                   String
  completedAt                 String?
  totalPostsFound             Int          @default(0)
  newPostsAdded               Int          @default(0)
  newAccountsFound            Int          @default(0)
  pagesScraped                Int          @default(0)
  errorMessage                String?
  errorBody                   String?
  checkpointMaxId             String?
  lostAccountsCount           Int          @default(0)
  lostAccountPks              String?
  newlyLostAccountsCount      Int          @default(0)
  newlyLostAccountPks         String?
  newlyRecoveredAccountsCount Int          @default(0)
  newlyRecoveredAccountPks    String?
  usernameChangesCount        Int          @default(0)
  usernameChangeAccountPks    String?

  @@index([profileId, startedAt])
  @@map("scrapeRuns")
}

model Setting {
  key       String @id @map("_id")
  value     String
  updatedAt String

  @@map("settings")
}

model Counter {
  id  String @id @map("_id")
  seq Int

  @@map("counters")
}
