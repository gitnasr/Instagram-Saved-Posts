# =================================================================
# Instagram Saved Posts Tracker - Environment Configuration
# =================================================================
# NOTE: When running via docker-compose, NO manual configuration is
# required! All core services are pre-wired out of the box.
# =================================================================

# -----------------------------------------------------------------
# 1. Core Application & Database
# -----------------------------------------------------------------
# Port on the host machine to expose the application (default: 5050)
PORT=5050

# MongoDB Connection String (pre-configured with replica set for transactions)
DATABASE_URL="mongodb://mongo:27017/instagram?replicaSet=rs0&directConnection=true"

# Environment Mode (production / development)
NODE_ENV=production

# -----------------------------------------------------------------
# 2. Cloudinary Permanent Media CDN (Optional)
# -----------------------------------------------------------------
# Instagram CDN URLs expire after several days. Setting Cloudinary
# credentials enables permanent storage for post images & thumbnails.
# Free plan: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------
# 3. Vector Database - Qdrant (Pre-wired in docker-compose)
# -----------------------------------------------------------------
# Host port exposed for Qdrant API & Web Dashboard (default: 6335)
# Dashboard UI: http://localhost:6335/dashboard
QDRANT_PORT=6335

# Pre-configured in docker-compose (http://qdrant:6333).
# For local dev without docker compose or custom setup:
QDRANT_URL="http://localhost:6335"
# QDRANT_API_KEY=

# -----------------------------------------------------------------
# 4. Logging & Telemetry (Optional)
# -----------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Next.js telemetry disable
NEXT_TELEMETRY_DISABLED=1
