# =================================================================
# Instagram Saved Posts Tracker - Environment Configuration
# =================================================================
# NOTE: When running via docker-compose, NO manual configuration is
# required! All core services are pre-wired out of the box.
# =================================================================

# -----------------------------------------------------------------
# 1. Core Application & Database
# -----------------------------------------------------------------
# Port on the host machine to expose the application (default: 3000)
PORT=3000

# MongoDB Connection String (pre-configured for docker-compose)
DATABASE_URL="mongodb://mongo:27017/instagram"

# Environment Mode (production / development)
NODE_ENV=production

# -----------------------------------------------------------------
# 2. Cloudinary Permanent Media CDN (Optional)
# -----------------------------------------------------------------
# Instagram CDN URLs expire after several days. Setting Cloudinary
# credentials enables permanent storage for post images & thumbnails.
# Free plan: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------
# 3. Logging & Telemetry (Optional)
# -----------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Next.js telemetry disable
NEXT_TELEMETRY_DISABLED=1
